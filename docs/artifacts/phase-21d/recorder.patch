+    recorder_row recorder_top32(const float * logits, int32_t n_vocab) const {
+        GGML_ASSERT(logits != nullptr);
+        GGML_ASSERT(n_vocab >= 32);
+
+        float max_logit = -INFINITY;
+        for (int32_t id = 0; id < n_vocab; ++id) {
+            GGML_ASSERT(!std::isnan(logits[id]) && logits[id] != INFINITY);
+            max_logit = std::max(max_logit, logits[id]);
+        }
+        GGML_ASSERT(std::isfinite(max_logit));
+
+        double sum_exp = 0.0;
+        for (int32_t id = 0; id < n_vocab; ++id) {
+            sum_exp += std::exp((double) logits[id] - (double) max_logit);
+        }
+        GGML_ASSERT(std::isfinite(sum_exp) && sum_exp > 0.0);
+        const double logsumexp = (double) max_logit + std::log(sum_exp);
+
+        std::vector<int32_t> ids(n_vocab);
+        std::iota(ids.begin(), ids.end(), 0);
+        std::partial_sort(ids.begin(), ids.begin() + 32, ids.end(), [logits](int32_t a, int32_t b) {
+            if (logits[a] == logits[b]) {
+                return a < b;
+            }
+            return logits[a] > logits[b];
+        });
+
+        recorder_row row = { logsumexp, {} };
+        row.candidates.reserve(32);
+        for (int32_t k = 0; k < 32; ++k) {
+            const float log_prob = (float) ((double) logits[ids[k]] - logsumexp);
+            GGML_ASSERT(std::isfinite(log_prob));
+            row.candidates.push_back({ ids[k], log_prob });
+        }
+        return row;
+    }
