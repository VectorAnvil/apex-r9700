+static void init_tensor_phase10_deterministic(ggml_tensor * tensor, uint32_t seed) {
+    const size_t nels = ggml_nelements(tensor);
+    std::vector<float> data(nels);
+    uint32_t state = seed;
+    for (size_t i = 0; i < nels; ++i) {
+        state = state * 1664525u + 1013904223u;
+        data[i] = ((state >> 8) & 0x3ffu) * (2.0f / 1023.0f) - 1.0f;
+    }
+
+    if (tensor->type == GGML_TYPE_F32) {
+        ggml_backend_tensor_set(tensor, data.data(), 0, nels * sizeof(float));
+        return;
+    }
+
+    GGML_ASSERT(ggml_is_quantized(tensor->type));
+    GGML_ASSERT(nels % ggml_blck_size(tensor->type) == 0);
+    std::vector<uint8_t> dataq(ggml_row_size(tensor->type, nels));
+    ggml_quantize_chunk(tensor->type, data.data(), dataq.data(), 0, nels / ggml_blck_size(tensor->type), ggml_blck_size(tensor->type), nullptr);
+    ggml_backend_tensor_set(tensor, dataq.data(), 0, dataq.size());
+}
