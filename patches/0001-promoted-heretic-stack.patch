+struct test_q6k_canonical_rows : public test_case {
+    const int64_t m;
+    const int64_t n;
+    const int64_t k;
+    ggml_tensor * batched = nullptr;
+    ggml_tensor * reference = nullptr;
+
+    test_q6k_canonical_rows(int64_t m, int64_t n, int64_t k) : m(m), n(n), k(k) {}
+
+    std::string vars() override { return VARS_TO_STR3(m, n, k); }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "Q6K_CANONICAL_ROWS";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * weight = ggml_new_tensor_2d(ctx, GGML_TYPE_Q6_K, k, m);
+        ggml_tensor * input = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_set_name(weight, m == 8704 ? "blk.0.ffn_gate.weight" :
+                              k == 8704 ? "blk.0.ffn_down.weight" : "canonical_weight");
+        ggml_set_name(input, "canonical_input");
+
+        batched = ggml_mul_mat(ctx, weight, input);
+        ggml_set_name(batched, "canonical_batched");
+
+        reference = nullptr;
+        for (int64_t row = 0; row < n; ++row) {
+            ggml_tensor * input_row = ggml_view_2d(ctx, input, k, 1, input->nb[1], row*input->nb[1]);
+            ggml_tensor * output_row = ggml_mul_mat(ctx, weight, input_row);
+            reference = reference == nullptr ? output_row : ggml_concat(ctx, reference, output_row, 1);
+        }
+        ggml_set_name(reference, "canonical_reference");
+
+        ggml_tensor * difference = ggml_sub(ctx, batched, reference);
+        ggml_set_name(difference, "canonical_difference");
+        return difference;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        uint32_t seed = 0x38c000u + uint32_t(m) + 3u*uint32_t(n) + 5u*uint32_t(k);
+        for (ggml_tensor * tensor = ggml_get_first_tensor(ctx); tensor != nullptr;
+             tensor = ggml_get_next_tensor(ctx, tensor)) {
+            if (tensor->op == GGML_OP_NONE) {
+                init_tensor_c07_deterministic(tensor, seed++);
+            }
+        }
+    }
+
+    bool validate_backend_graph(ggml_backend_t backend) override {
+        GGML_UNUSED(backend);
+        const size_t nbytes = ggml_nbytes(batched);
+        std::vector<uint8_t> batched_data(nbytes);
+        std::vector<uint8_t> reference_data(nbytes);
+        ggml_backend_tensor_get(batched, batched_data.data(), 0, nbytes);
+        ggml_backend_tensor_get(reference, reference_data.data(), 0, nbytes);
+        if (memcmp(batched_data.data(), reference_data.data(), nbytes) == 0) {
+            return true;
+        }
+        for (size_t offset = 0; offset < nbytes; offset += sizeof(float)) {
+            if (memcmp(batched_data.data() + offset, reference_data.data() + offset, sizeof(float)) != 0) {
+                uint32_t batched_bits;
+                uint32_t reference_bits;
+                memcpy(&batched_bits, batched_data.data() + offset, sizeof(batched_bits));
+                memcpy(&reference_bits, reference_data.data() + offset, sizeof(reference_bits));
+                printf("canonical-row bit mismatch at element %zu: 0x%08x != 0x%08x ",
+                       offset/sizeof(float), batched_bits, reference_bits);
+                break;
+            }
+        }
+        return false;
+    }
+
+    double max_nmse_err() override { return 5e-4; }
+};
