     }
 }
+
+static __global__ void quantize_swiglu_mmq_q8_1_d4(
+        const float * __restrict__ gate, const float * __restrict__ up,
+        block_q8_1_mmq * __restrict__ y, const int64_t ne0, const int64_t ne1) {
+    const int lane = threadIdx.x;
+    const int64_t i0 = (int64_t) blockIdx.x * (4 * QK8_1) + 4 * lane;
+    const int64_t row = blockIdx.y;
+    const int64_t offset = row * ne0 + i0;
+
+    const float4 gate4 = ((const float4 *) gate)[offset / 4];
+    const float4 up4   = ((const float4 *) up)[offset / 4];
+    float4 value;
+    value.x = ggml_cuda_op_silu_single(gate4.x) * up4.x;
+    value.y = ggml_cuda_op_silu_single(gate4.y) * up4.y;
+    value.z = ggml_cuda_op_silu_single(gate4.z) * up4.z;
+    value.w = ggml_cuda_op_silu_single(gate4.w) * up4.w;
+
+    float amax = fabsf(value.x);
+    amax = fmaxf(amax, fabsf(value.y));
+    amax = fmaxf(amax, fabsf(value.z));
+    amax = fmaxf(amax, fabsf(value.w));
+
+#pragma unroll
+    for (int offset_lane = 4; offset_lane > 0; offset_lane >>= 1) {
+        amax = fmaxf(amax, __shfl_xor_sync(0xFFFFFFFF, amax, offset_lane, WARP_SIZE));
+    }
+
+    const float d_inv = 127.0f / amax;
+    char4 q;
+    q.x = roundf(value.x * d_inv);
+    q.y = roundf(value.y * d_inv);
+    q.z = roundf(value.z * d_inv);
+    q.w = roundf(value.w * d_inv);
+
+    block_q8_1_mmq & block = y[(int64_t) blockIdx.x * ne1 + row];
+    ((char4 *) block.qs)[lane] = q;
+    if (lane % 8 == 0) {
+        block.d4[lane / 8] = 1.0f / d_inv;
+    }
+}
+
+void quantize_swiglu_mmq_q8_1_d4_cuda(
+        const float * gate, const float * up, void * vy,
+        const int64_t ne0, const int64_t ne1, cudaStream_t stream) {
+    GGML_ASSERT(ne0 % (4 * QK8_1) == 0);
+
+    const dim3 num_blocks(ne0 / (4 * QK8_1), ne1, 1);
+    const dim3 block_size(WARP_SIZE, 1, 1);
+    quantize_swiglu_mmq_q8_1_d4<<<num_blocks, block_size, 0, stream>>>(
+        gate, up, (block_q8_1_mmq *) vy, ne0, ne1);
+}
