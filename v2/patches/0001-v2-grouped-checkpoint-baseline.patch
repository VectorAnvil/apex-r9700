diff --git a/ggml/src/ggml-cuda/apex-p2p.cuh b/ggml/src/ggml-cuda/apex-p2p.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..3f2dd75a6fa041eb5c2a58e41055260cd0dc0d23
--- /dev/null
+++ b/ggml/src/ggml-cuda/apex-p2p.cuh
@@ -0,0 +1,262 @@
+#pragma once
+
+// Adapted from August APEX's integration of JohnTDI-cpu's HIP P2P AllReduce.
+// Keep upstream wire precision and large-tensor dispatch for a matched A/B.
+#if defined(GGML_USE_HIP)
+struct apex_p2p_pipeline {
+    static constexpr int blocks = 8;
+    static constexpr size_t bytes = 512 * 1024;
+    int devices[2];
+    char * staging[2] = {};
+    unsigned * inbox[2] = {};
+    unsigned * tokens[2] = {};
+    uint64_t calls = 0;
+    uint64_t boundary_calls = 0;
+};
+
+static void apex_p2p_free(apex_p2p_pipeline * p) {
+    if (!p) {
+        return;
+    }
+    GGML_LOG_INFO("APEX P2P launch calls: %llu\n", (unsigned long long) p->calls);
+    GGML_LOG_INFO("APEX fused boundary calls: %llu\n", (unsigned long long) p->boundary_calls);
+    for (int i = 0; i < 2; ++i) {
+        ggml_cuda_set_device(p->devices[i]);
+        CUDA_CHECK(hipDeviceSynchronize());
+        if (p->staging[i]) { CUDA_CHECK(hipFree(p->staging[i])); }
+        if (p->inbox[i])   { CUDA_CHECK(hipFree(p->inbox[i])); }
+        if (p->tokens[i])  { CUDA_CHECK(hipFree(p->tokens[i])); }
+    }
+    delete p;
+}
+
+static apex_p2p_pipeline * apex_p2p_init(const int * devices) {
+    const char * enabled = getenv("APEX_V2_DIRECT_P2P");
+    if (!enabled || strcmp(enabled, "1") != 0) {
+        return nullptr;
+    }
+    for (int i = 0; i < 2; ++i) {
+        hipDeviceProp_t prop;
+        int can = 0;
+        ggml_cuda_set_device(devices[i]);
+        if (hipGetDeviceProperties(&prop, devices[i]) != hipSuccess ||
+            strncmp(prop.gcnArchName, "gfx1201", 7) != 0 ||
+            hipDeviceCanAccessPeer(&can, devices[i], devices[1-i]) != hipSuccess || !can) {
+            GGML_LOG_WARN("APEX P2P requires two gfx1201 devices with peer access; using upstream AllReduce\n");
+            (void) hipGetLastError();
+            return nullptr;
+        }
+        const hipError_t err = hipDeviceEnablePeerAccess(devices[1-i], 0);
+        (void) hipGetLastError();
+        if (err != hipSuccess && err != hipErrorPeerAccessAlreadyEnabled) {
+            return nullptr;
+        }
+    }
+    auto * p = new apex_p2p_pipeline;
+    p->devices[0] = devices[0];
+    p->devices[1] = devices[1];
+    for (int i = 0; i < 2; ++i) {
+        ggml_cuda_set_device(devices[i]);
+        if (hipMalloc((void **) &p->staging[i], 2*p->bytes) != hipSuccess ||
+            hipMalloc((void **) &p->inbox[i], 2*p->blocks*sizeof(unsigned)) != hipSuccess ||
+            hipMalloc((void **) &p->tokens[i], p->blocks*sizeof(unsigned)) != hipSuccess ||
+            hipMemset(p->inbox[i], 0, 2*p->blocks*sizeof(unsigned)) != hipSuccess ||
+            hipMemset(p->tokens[i], 0, p->blocks*sizeof(unsigned)) != hipSuccess) {
+            (void) hipGetLastError();
+            apex_p2p_free(p);
+            return nullptr;
+        }
+    }
+    GGML_LOG_INFO("APEX P2P ready: 2 gfx1201 GPUs, 8 blocks, upstream wire precision, <=512 KiB\n");
+    return p;
+}
+
+template <typename T, typename W>
+static __global__ void apex_p2p_kernel(
+        T * data, W * mine, const W * peer, int count, bool compute,
+        volatile unsigned * inbox, volatile unsigned * peer_inbox, unsigned * tokens) {
+    const int bid = blockIdx.x;
+    const int tid = bid * blockDim.x + threadIdx.x;
+    const int stride = gridDim.x * blockDim.x;
+    for (int i = tid; i < count; i += stride) {
+        mine[i] = compute ? ggml_cuda_cast<W>(data[i]) : ggml_cuda_cast<W>(0.0f);
+    }
+    __threadfence_system();
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        // Device counters advance on graph replay too; host counters do not.
+        const unsigned token = ++tokens[bid];
+        peer_inbox[bid] = token;
+        __threadfence_system();
+        while (inbox[bid] != token) {
+            __builtin_amdgcn_s_sleep(2);
+        }
+    }
+    __syncthreads();
+    __threadfence_system();
+    for (int i = tid; i < count; i += stride) {
+        const float local = compute ? ggml_cuda_cast<float>(ggml_cuda_cast<W>(data[i])) : 0.0f;
+        data[i] = ggml_cuda_cast<T>(local + ggml_cuda_cast<float>(peer[i]));
+    }
+}
+
+template <typename T, typename W = T>
+static void apex_p2p_launch(apex_p2p_pipeline * p, ggml_backend_t * backends, ggml_tensor ** tensors) {
+    const int slot = (++p->calls) % 2;
+    const int count = (int) ggml_nelements(tensors[0]);
+    for (int i = 0; i < 2; ++i) {
+        auto * ctx = static_cast<ggml_backend_cuda_context *>(backends[i]->context);
+        GGML_ASSERT(ctx->device == p->devices[i]);
+        ggml_cuda_set_device(p->devices[i]);
+        apex_p2p_kernel<T, W><<<p->blocks, 256, 0, ctx->stream()>>>(
+            (T *) tensors[i]->data, (W *) (p->staging[i] + slot*p->bytes),
+            (W *) (p->staging[1-i] + slot*p->bytes), count,
+            (tensors[i]->flags & GGML_TENSOR_FLAG_COMPUTE) != 0,
+            p->inbox[i] + slot*p->blocks, p->inbox[1-i] + slot*p->blocks, p->tokens[i]);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
+
+static bool apex_p2p_allreduce(apex_p2p_pipeline * p, ggml_backend_t * backends,
+                               ggml_tensor ** tensors, bool bf16) {
+    if (!p || ggml_nbytes(tensors[0]) > p->bytes) {
+        return false;
+    }
+    switch (tensors[0]->type) {
+        case GGML_TYPE_F32:
+            if (bf16) { apex_p2p_launch<float, nv_bfloat16>(p, backends, tensors); }
+            else      { apex_p2p_launch<float>(p, backends, tensors); }
+            break;
+        case GGML_TYPE_F16:  apex_p2p_launch<half>(p, backends, tensors); break;
+        case GGML_TYPE_BF16: apex_p2p_launch<nv_bfloat16>(p, backends, tensors); break;
+        default: return false;
+    }
+    return true;
+}
+static __global__ void apex_p2p_fused_rms(
+        const float * __restrict__ partial,
+        const float * __restrict__ residual,
+        float       * __restrict__ add_out,
+        const float * __restrict__ weight,
+        float       * __restrict__ out,
+        float       * __restrict__ buf_mine,
+        const float * __restrict__ buf_peer,
+        int                         rows,
+        float                       eps,
+        volatile unsigned *              my_inbox,
+        volatile unsigned *              peer_inbox,
+        unsigned *                  dev_token,
+        int                         compute_mine,
+        bool                        bf16) {
+    constexpr int ncols = 5120;
+    constexpr int block_size = 1024;
+
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+    if (row >= rows) {
+        return;
+    }
+
+    const int64_t row_off = (int64_t) row * ncols;
+
+    for (int col = tid; col < ncols; col += block_size) {
+        buf_mine[row_off + col] = compute_mine ? (bf16 ? ggml_cuda_cast<float>(ggml_cuda_cast<nv_bfloat16>(partial[row_off + col])) : partial[row_off + col]) : 0.0f;
+    }
+    __threadfence_system();
+    __syncthreads();
+
+    if (tid == 0) {
+        const unsigned token = ++dev_token[row];
+        peer_inbox[row] = token;
+        __threadfence_system();
+        while (my_inbox[row] != token) {
+            __builtin_amdgcn_s_sleep(2);
+        }
+    }
+    __syncthreads();
+    __threadfence_system();
+
+    float sumsq = 0.0f;
+    for (int col = tid; col < ncols; col += block_size) {
+        const float mine = compute_mine ? (bf16 ? ggml_cuda_cast<float>(ggml_cuda_cast<nv_bfloat16>(partial[row_off + col])) : partial[row_off + col]) : 0.0f;
+        const float reduced = mine + buf_peer[row_off + col];
+        const float x = reduced + residual[row_off + col];
+        add_out[row_off + col] = x;
+        sumsq += x * x;
+    }
+
+    extern __shared__ float s_sum[];
+    sumsq = block_reduce<block_reduce_method::SUM, block_size>(sumsq, s_sum);
+    const float scale = rsqrtf(sumsq / ncols + eps);
+
+    for (int col = tid; col < ncols; col += block_size) {
+        out[row_off + col] = scale * add_out[row_off + col] * weight[col];
+    }
+}
+
+static bool apex_p2p_boundary(
+        apex_p2p_pipeline * p,
+        ggml_backend_t        * backends,
+        ggml_tensor           ** partials,
+        ggml_tensor           ** residuals,
+        ggml_tensor           ** add_outputs,
+        ggml_tensor           ** weights,
+        ggml_tensor           ** outputs,
+        float                    eps, bool bf16) {
+    if (p == nullptr || partials[0] == nullptr) {
+        return false;
+    }
+
+    constexpr int64_t ncols = 5120;
+    const int64_t ne = ggml_nelements(partials[0]);
+    if (partials[0]->type != GGML_TYPE_F32 || ne <= 0 || ne % ncols != 0) {
+        return false;
+    }
+    const int rows = (int) (ne / ncols);
+    if (rows < 1 || rows > apex_p2p_pipeline::blocks) {
+        return false;
+    }
+
+    for (int i = 0; i < 2; ++i) {
+        if (partials[i] == nullptr || residuals[i] == nullptr || add_outputs[i] == nullptr ||
+                weights[i] == nullptr || outputs[i] == nullptr ||
+                partials[i]->type != GGML_TYPE_F32 || residuals[i]->type != GGML_TYPE_F32 ||
+                add_outputs[i]->type != GGML_TYPE_F32 || weights[i]->type != GGML_TYPE_F32 ||
+                outputs[i]->type != GGML_TYPE_F32 ||
+                ggml_nelements(partials[i]) != ne || ggml_nelements(residuals[i]) != ne ||
+                ggml_nelements(add_outputs[i]) != ne || ggml_nelements(outputs[i]) != ne ||
+                ggml_nelements(weights[i]) != ncols ||
+                !ggml_is_contiguously_allocated(partials[i]) ||
+                !ggml_is_contiguously_allocated(residuals[i]) ||
+                !ggml_is_contiguously_allocated(add_outputs[i]) ||
+                !ggml_is_contiguously_allocated(weights[i]) ||
+                !ggml_is_contiguously_allocated(outputs[i])) {
+            return false;
+        }
+    }
+
+    const int slot = (int) (++p->calls) % 2;
+    for (int i = 0; i < 2; ++i) {
+        const int peer = 1 - i;
+        auto * ctx = (ggml_backend_cuda_context *) backends[i]->context;
+        ggml_cuda_set_device(p->devices[i]);
+
+        float * mine = (float *) (p->staging[i] + (size_t) slot * apex_p2p_pipeline::bytes);
+        float * peer_buf = (float *) (p->staging[peer] + (size_t) slot * apex_p2p_pipeline::bytes);
+        unsigned * my_inbox = p->inbox[i] + (size_t) slot * apex_p2p_pipeline::blocks;
+        unsigned * peer_inbox = p->inbox[peer] + (size_t) slot * apex_p2p_pipeline::blocks;
+        const int compute = (partials[i]->flags & GGML_TENSOR_FLAG_COMPUTE) != 0;
+
+        apex_p2p_fused_rms<<<rows, 1024, 32 * sizeof(float), ctx->stream()>>>(
+            (const float *) partials[i]->data,
+            (const float *) residuals[i]->data,
+            (float *) add_outputs[i]->data,
+            (const float *) weights[i]->data,
+            (float *) outputs[i]->data,
+            mine, peer_buf, rows, eps, my_inbox, peer_inbox, p->tokens[i], compute, bf16);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    ++p->boundary_calls;
+    return true;
+}
+#endif
