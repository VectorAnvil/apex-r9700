+    if (ggml_backend_buffer_get_usage(down_weight->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        const size_t size_data  = ggml_nbytes(down_weight);
+        const size_t size_alloc = ggml_backend_buffer_get_alloc_size(down_weight->buffer, down_weight);
+        if (size_alloc > size_data) {
+            GGML_ASSERT(ggml_is_contiguously_allocated(down_weight));
+            GGML_ASSERT(!down_weight->view_src);
+            CUDA_CHECK(cudaMemsetAsync((char *) down_weight->data + size_data, 0, size_alloc - size_data, stream));
