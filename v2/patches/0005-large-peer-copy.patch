+#if APEX_V2_AR_PEER_COPY
+template <typename T_src, typename T_dst>
+static bool ggml_cuda_ar_allreduce_peer_copy_impl(
+        ggml_cuda_ar_pipeline * p,
+        ggml_backend_t * backends,
+        T_src * const src_buf[GGML_CUDA_MAX_DEVICES],
+        T_dst * const dst_buf[GGML_CUDA_MAX_DEVICES],
+        const bool compute[GGML_CUDA_MAX_DEVICES],
+        int64_t ne,
+        size_t nbytes) {
+    GGML_ASSERT(p->n_devices == 2 && nbytes <= p->copy_bytes);
+    GGML_ASSERT(ne <= std::numeric_limits<int>::max());
+    const size_t chunk_bytes = ggml_cuda_ar_chunk_bytes(p, nbytes);
+    GGML_ASSERT(chunk_bytes > 0);
+    const int slot = ggml_cuda_ar_acquire_slot(p).slot;
+    ggml_backend_cuda_context * ctx[2] = {};
+
+    for (int i = 0; i < 2; ++i) {
+        ggml_cuda_set_device(p->devices[i]);
+        ctx[i] = static_cast<ggml_backend_cuda_context *>(backends[i]->context);
+        GGML_ASSERT(ctx[i]->device == p->devices[i]);
+        if (!compute[i]) {
+            CUDA_CHECK(cudaMemsetAsync(src_buf[i], 0, nbytes, ctx[i]->stream()));
+        }
+        ggml_cuda_ar_wait_for_compute(p, ctx[i], i, slot);
+        if (p->dev_tmp_kernel_done_valid) {
+            CUDA_CHECK(cudaStreamWaitEvent(p->streams[i], p->dev_tmp_kernel_done[i]));
+        }
+    }
+
+    for (int i = 0; i < 2; ++i) {
+        const int peer = 1 - i;
+        ggml_cuda_set_device(p->devices[i]);
+        CUDA_CHECK(cudaStreamWaitEvent(p->streams[i], p->ev_pool[peer][slot].app));
+        for (size_t offset = 0; offset < nbytes; offset += chunk_bytes) {
+            const size_t size = std::min(chunk_bytes, nbytes - offset);
+            CUDA_CHECK(hipMemcpyPeerAsync(p->dev_tmp[i] + offset, p->devices[i],
+                reinterpret_cast<const char *>(src_buf[peer]) + offset, p->devices[peer], size, p->streams[i]));
+        }
+        CUDA_CHECK(cudaEventRecord(p->ev_pool[i][slot].h2d, p->streams[i]));
+    }
+
+    // Both reads must finish before in-place writes or pooled source reuse.
+    for (int i = 0; i < 2; ++i) {
+        ggml_cuda_set_device(p->devices[i]);
+        CUDA_CHECK(cudaStreamWaitEvent(ctx[i]->stream(), p->ev_pool[i][slot].h2d));
+        CUDA_CHECK(cudaStreamWaitEvent(ctx[i]->stream(), p->ev_pool[1 - i][slot].h2d));
+        const int blocks = (int) std::min(int64_t(1024), (ne + 255) / 256);
+        ggml_cuda_ar_add_kernel<T_dst, T_src><<<blocks, 256, 0, ctx[i]->stream()>>>(
+            dst_buf[i], reinterpret_cast<const T_src *>(p->dev_tmp[i]), (int) ne);
+        CUDA_CHECK(cudaGetLastError());
+        CUDA_CHECK(cudaEventRecord(p->dev_tmp_kernel_done[i], ctx[i]->stream()));
+        CUDA_CHECK(cudaEventRecord(p->ev_pool[i][slot].ker, ctx[i]->stream()));
+    }
+    p->dev_tmp_kernel_done_valid = true;
+    return true;
+}
+#endif
